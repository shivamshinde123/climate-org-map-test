# Copy this file to .env and populate the API keys.
# OpenRouter key — used for both web-search discovery and Jev classification.
OPENROUTER_API_KEY=your_openrouter_api_key
# Brave Search API key — primary website discovery path, OpenRouter web search is the fallback.
# Get a key at https://brave.com/search/api/
BRAVE_API_KEY=your_brave_api_key

# Optional model and endpoint overrides.
SEARCH_MODEL=openai/gpt-5.4-mini
SEARCH_BASE_URL=https://openrouter.ai/api/v1/chat/completions
JEV_MODEL=typesafe/jev-1.13
JEV_BASE_URL=https://openrouter.ai/api/alpha/decisions
