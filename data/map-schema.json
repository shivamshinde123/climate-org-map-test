{
  "version": 1,
  "fields": [
    "name",
    "website_url",
    "source_url",
    "email",
    "phone",
    "contact_page_url",
    "address",
    "city",
    "state",
    "postal_code",
    "latitude",
    "longitude",
    "summary",
    "notes",
    "irs_category",
    "gcc_climate_category",
    "gcc_action_category",
